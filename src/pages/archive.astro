---
import { getCollection, type CollectionEntry } from "astro:content";
import BlogLayout from "@/layouts/BlogLayout.astro";
import IndexHeader from "@/components/blog/IndexHeader.astro";
import { withBase } from "@cloudflare/nimbus-docs/runtime";

export const prerender = true;

type Entry = CollectionEntry<"blog">;

const entries = (await getCollection("blog", (e) => !e.data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

// Grouped on the same UTC clock the sort and the frontmatter use, so a post
// can never appear under a day it was not dated. Plain arithmetic instead of
// Intl: the month label is "9 月" and there is no locale decision to get wrong.
interface MonthGroup {
  label: string;
  entries: Entry[];
}
interface YearGroup {
  year: number;
  count: number;
  months: MonthGroup[];
}

const years: YearGroup[] = [];

for (const entry of entries) {
  const date = entry.data.date;
  const month = date.getUTCMonth();

  let year = years.at(-1);
  if (!year || year.year !== date.getUTCFullYear()) {
    year = { year: date.getUTCFullYear(), count: 0, months: [] };
    years.push(year);
  }
  year.count += 1;

  let group = year.months.at(-1);
  if (!group || group.label !== `${month + 1} 月`) {
    group = { label: `${month + 1} 月`, entries: [] };
    year.months.push(group);
  }
  group.entries.push(entry);
}

const day = (date: Date) => String(date.getUTCDate()).padStart(2, "0");
---

<BlogLayout title="归档" description="全部文章，按年月归档" socialImage="/og/blog.png">
  <IndexHeader
    title="归档"
    meta={years.length > 0
      ? `${entries.length} 篇文章 · ${years.length} 年`
      : "还没有发布任何文章。"}
  />

  {
    years.map((year) => (
      <section class="mb-14 last:mb-0">
        <div class="mb-7 flex items-baseline gap-3 border-b border-border pb-2">
          <h2
            class="m-0 font-serif text-foreground"
            style="font-size:1.75rem;font-weight:var(--nb-h2-weight);letter-spacing:var(--nb-h2-tracking);line-height:var(--nb-h2-leading)"
          >
            {year.year}
          </h2>
          <span class="font-sans text-[0.8125rem] tabular-nums text-muted-foreground">
            {year.count} 篇
          </span>
        </div>

        {year.months.map((month) => (
          <div class="mb-9 last:mb-0">
            <h3 class="m-0 mb-1 font-serif text-[1.0625rem] font-semibold text-muted-foreground">
              {month.label}
            </h3>
            <ul class="m-0 list-none p-0">
              {month.entries.map((entry) => (
                <li>
                  <a
                    href={withBase(`/blog/${entry.id}`, import.meta.env.BASE_URL)}
                    class="group flex items-baseline gap-4 py-2 no-underline"
                  >
                    <time
                      datetime={entry.data.date.toISOString()}
                      class="w-6 shrink-0 font-sans text-[0.75rem] tabular-nums text-muted-foreground"
                    >
                      {day(entry.data.date)}
                    </time>
                    <span class="font-serif text-[1.0625rem] leading-snug text-foreground transition-colors group-hover:text-primary">
                      {entry.data.title}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </section>
    ))
  }
</BlogLayout>
