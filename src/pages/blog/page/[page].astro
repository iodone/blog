---
import { getCollection } from "astro:content";
import BlogLayout from "@/layouts/BlogLayout.astro";
import BlogFeed from "@/components/blog/BlogFeed.astro";
import { Pagination } from "@/components/ui/pagination";
import { withBase } from "@cloudflare/nimbus-docs/runtime";

export const prerender = true;

export async function getStaticPaths() {
  const PAGE_SIZE = 20;
  const entries = (await getCollection("blog", (e) => !e.data.draft)).sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime(),
  );
  const totalPages = Math.max(1, Math.ceil(entries.length / PAGE_SIZE));
  const paths = [];
  for (let page = 2; page <= totalPages; page++) {
    paths.push({
      params: { page: String(page) },
      props: {
        slice: entries.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE),
        page,
        totalPages,
      },
    });
  }
  return paths;
}

interface Props {
  slice: Awaited<ReturnType<typeof getCollection<"blog">>>;
  page: number;
  totalPages: number;
}

const { slice, page, totalPages } = Astro.props as Props;
const prev = {
  label: page === 2 ? "最新" : `第 ${page - 1} 页`,
  href: page === 2 ? "/blog" : `/blog/page/${page - 1}`,
};
const next =
  page < totalPages ? { label: `第 ${page + 1} 页`, href: `/blog/page/${page + 1}` } : undefined;
---

<BlogLayout title={`Meta42 — Page ${page}`} description="" socialImage="/og/blog.png" noindex>
  <header class="mb-14">
    <a
      href={withBase("/blog", import.meta.env.BASE_URL)}
      class="mb-4 inline-block text-[0.8125rem] font-medium text-muted-foreground no-underline hover:text-foreground"
    >
      ← 最新
    </a>
    {/* h1 token trio via inline style — site convention. */}
    <h1
      class="m-0 font-serif leading-[1.1] text-foreground"
      style="font-size:var(--nb-h1-size);font-weight:var(--nb-h1-weight);letter-spacing:var(--nb-h1-tracking)"
    >
      Meta42
    </h1>
    <p class="mt-2.5 text-[1.0625rem] leading-normal text-muted-foreground">
      第 {page} / {totalPages} 页
    </p>
  </header>

  <BlogFeed entries={slice} leadFirst={false} />

  <div class="mt-12">
    <Pagination prevNext={{ prev, next }} />
  </div>
</BlogLayout>
