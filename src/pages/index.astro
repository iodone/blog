---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import { navSections } from "@/lib/nav";
import { config } from "virtual:nimbus/config";
import { withBase } from "@cloudflare/nimbus-docs/runtime";

// Prerender explicitly so the homepage stays a static route under
// `output: "server"` — an adapter alone must add zero on-demand routes.
export const prerender = true;
---

<BaseLayout title={config.title} description={config.description}>
  <div class="flex flex-col min-h-screen">
    <Header sections={navSections(Astro.url.pathname, import.meta.env.BASE_URL)} />
    <main id="main-content" tabindex="-1" class="flex-1 mx-auto max-w-2xl w-full px-6 py-24">
      <h1
        class="font-serif text-foreground leading-tight"
        style="font-size: var(--nb-h1-size); font-weight: var(--nb-h1-weight); letter-spacing: var(--nb-h1-tracking);"
      >
        {config.title}
      </h1>
      <p class="mt-2 text-[1.0625rem] text-muted-foreground leading-relaxed">
        {config.description}
      </p>

      <div class="mt-8 grid grid-cols-1 gap-3 sm:grid-cols-2">
        <a
          href={withBase("/blog", import.meta.env.BASE_URL)}
          class="block rounded-lg border border-border p-4 transition-colors hover:border-border-strong no-underline"
        >
          <div class="font-medium text-foreground">Blog</div>
          <div class="mt-0.5 text-sm text-muted-foreground">最新文章</div>
        </a>
        <a
          href={withBase("/about", import.meta.env.BASE_URL)}
          class="block rounded-lg border border-border p-4 transition-colors hover:border-border-strong no-underline"
        >
          <div class="font-medium text-foreground">关于</div>
          <div class="mt-0.5 text-sm text-muted-foreground">这个站点是什么</div>
        </a>
      </div>
    </main>
  </div>
</BaseLayout>
